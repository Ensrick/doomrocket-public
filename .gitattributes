# Preserve the actual compiler input bytes in standalone build receipts.
# This also preserves the byte-identical copied upstream workflow snapshot.
* -text

# The deterministic Wwise builder emits LF. Keep its text products byte-stable
# on Windows checkouts so clean-room reproduction remains a real byte check.
wwise/*.wwise_bank_metadata text eol=lf
wwise/*.wwise_dep text eol=lf
wwise/*.wwise_metadata text eol=lf
wwise/*.json text eol=lf
